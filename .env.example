# Cert Copilot (ver src/features/cert-copilot/config.ts)
# Base de la API. Vacío = mismo origen (en `pnpm dev` Vite hace proxy de /api/cert a http://localhost:8787).
VITE_CERT_API_URL=
# El demo siempre está activo en `pnpm dev`. En producción la tarjeta del proyecto se ve igual, pero el demo
# solo se activa con esto en "true" (hazlo cuando exista la API); si no, muestra "Live demo coming soon".
VITE_CERT_COPILOT=false
